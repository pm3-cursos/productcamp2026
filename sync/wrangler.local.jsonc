{
  // Só para o D1 LOCAL (wrangler d1 execute --local e wrangler pages dev).
  // Fica dentro de sync/ de propósito: um wrangler.toml/jsonc na raiz faria o
  // Cloudflare Pages passar a ler a configuração do arquivo em vez do painel.
  // O database_id "DB" é o mesmo que `wrangler pages dev . --d1 DB` usa, então
  // os dois enxergam o mesmo banco em .wrangler/state.
  "name": "pcamp-indicacao-local",
  // O script passa --persist-to .wrangler/state (na raiz) para o banco ser o
  // mesmo do `wrangler pages dev`. Sem isso, o estado ficaria em sync/.wrangler.
  "compatibility_date": "2025-09-01",
  "d1_databases": [
    { "binding": "DB", "database_name": "DB", "database_id": "DB" }
  ]
}
